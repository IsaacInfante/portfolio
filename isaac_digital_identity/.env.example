# Usa tu propia clave obtenida en https://aistudio.google.com/apikey
# NUNCA publiques este archivo con una clave real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# URL PUBLICA opcional; necesario si el QR debe funcionar desde otro dispositivo
# PUBLIC_BASE_URL=https://tu-dominio.com
PUBLIC_BASE_URL=
PORT=5000
# Solo para localhost: activar debug a través de `flask --app app run --debug` (no en producción)

# Etapa 1: usa configure_owner.py para crear un archivo privado NUEVO.
# Seleccionarlo desde PowerShell: $env:PORTFOLIO_ENV_FILE='ruta/archivo'
# Las rutas relativas se resuelven respecto a la carpeta de app.py.
OWNER_PROFILE_PATH=data/isaac.json
DATABASE_PATH=data/profiles.db
# Vacio: se genera una vez y se conserva en la base SQLite.
INSTANCE_ID=
# Sin ambos valores, las operaciones del propietario permanecen bloqueadas.
# Nunca establecer una contrasena en texto plano ni credenciales predeterminadas.
OWNER_PASSWORD_HASH=
SECRET_KEY=
# true por defecto: requiere HTTPS. false solo en desarrollo HTTP local.
SESSION_COOKIE_SECURE=true
